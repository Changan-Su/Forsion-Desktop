{
  "manifest_version": 3,
  "name": "Forsion Launcher",
  "version": "1.0.0",
  "description": "每次打开浏览器和新建标签页时，自动打开 forsion.net。",
  "minimum_chrome_version": "102",
  "permissions": ["tabs"],
  "background": {
    "service_worker": "background.js"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "action": {
    "default_title": "打开 Forsion",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
