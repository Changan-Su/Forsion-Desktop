# Frontend image / container
COMPOSE_PROJECT_NAME=forsion-desktop
FRONTEND_IMAGE=forsion-desktop-frontend:latest
FRONTEND_PORT=2005

# Build-time variables（构建时烧入 bundle，修改后需重新 build 镜像）
# 必须设置为后端服务的完整地址，auth 跳转和 API 请求都依赖此变量
VITE_API_URL=http://localhost:3001
VITE_PROJECT_SOURCE=desktop

# Runtime reverse proxy target
# 同机开发后端可保持默认；若后端在其他主机或容器网络中，请改成对应地址
FORSION_BACKEND_URL=http://host.docker.internal:3001
